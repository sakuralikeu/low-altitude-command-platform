# Change this before any shared or production deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_PORT=8080
TZ=Asia/Shanghai

# Optional: AMap Web JS API 2.0. Without these, the UI uses a local demo basemap.
# 高德开放平台 -> 应用管理 -> 创建「Web端(JS API)」应用，将本服务域名(含 localhost)加入
# 「域名白名单」，然后填入 Key 与安全密钥，重新构建镜像后生效。
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Optional: header 天气播报文案（演示数据可替换为真实天气服务）
VITE_WEATHER_LABEL=多云 29℃

# 规划航线持久化路径（本地开发用 data/，Docker 由 compose 注入 /data）
ROUTES_FILE=data/flight-routes.json
